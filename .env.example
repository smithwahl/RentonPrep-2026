# --- Site configuration ---
# Required in production: canonical URL for metadata and OG tags. Must start with https://.
NEXT_PUBLIC_SITE_URL=
# Optional: Google Analytics 4 measurement ID (format: G-XXXXXXXXXX). If unset, no analytics load.
NEXT_PUBLIC_GA_ID=
# Optional: external application portal URL (e.g. FACTS / RenWeb). If unset, a default RenWeb URL is used in code.
NEXT_PUBLIC_APPLY_URL=

# --- CMS ---
# "api" = read Page/Menu content from the custom .NET CMS API (Agape.CmsApi, the
# RentonPrep.Page repo) instead of the local JSON stand-in under lib/cms/data/ (default when
# unset/anything else). Settings has no CMS-backed source yet — no Settings content type
# exists in the CMS yet.
CMS_SOURCE=

# --- CMS (custom .NET API) — used when CMS_SOURCE=api ---
# Base URL for the CmsMenus Function App (no trailing slash), e.g. https://your-cmsmenus.azurewebsites.net/api.
CMS_MENUS_API_URL=
# Function key for CmsMenus, if its routes require one (local `func start` doesn't). Sent as ?code=.
CMS_MENUS_API_KEY=
# Base URL for the CmsPages Function App (no trailing slash), e.g. https://your-cmspages.azurewebsites.net/api.
CMS_PAGES_API_URL=
# Function key for CmsPages, if its routes require one (local `func start` doesn't). Sent as ?code=.
CMS_PAGES_API_KEY=
